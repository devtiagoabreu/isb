generator client {
  provider            = "prisma-client"
  output              = "../prisma/generated"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model BlingToken {
  id           Int      @id @default(1)
  accessToken  String
  refreshToken String
  tokenType    String   @default("Bearer")
  scope        String?
  expiresAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("bling_tokens")
}

model BlingTest {
  id           Int      @id @default(autoincrement())
  method       String
  endpoint     String
  label        String?
  params       Json?
  status       Int?
  durationMs   Int?
  success      Boolean  @default(false)
  responseBody String?
  responseAt   DateTime @default(now())

  @@map("bling_tests")
}

model BlingWebhook {
  id         Int      @id @default(autoincrement())
  eventId    String   @unique
  event      String
  version    String?
  companyId  String?
  payload    Json
  receivedAt DateTime @default(now())

  @@map("bling_webhooks")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  roleId       Int?
  role         Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  builtin     Boolean          @default(false)
  createdAt   DateTime         @default(now())
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model RolePermission {
  roleId Int
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  key    String

  @@id([roleId, key])
  @@map("role_permissions")
}