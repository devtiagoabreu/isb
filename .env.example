# Configurações do Bling V3
BLING_CLIENT_ID=seu_client_id_bling
BLING_CLIENT_SECRET=seu_client_secret_bling
BLING_WEBHOOK_SECRET=seu_webhook_secret_bling
BLING_REDIRECT_URI=http://localhost:3000/api/bling/callback

# Banco de dados Neon (preencher com suas credenciais)
DATABASE_URL=postgresql://usuario:senha@host-pooler.sa-east-1.aws.neon.tech/banco?sslmode=require&pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://usuario:senha@host.sa-east-1.aws.neon.tech/banco?sslmode=require

# Configurações da Systêxtil Cloud (base URL é por cliente)
# Produção: https://api-{customer_id}.systextilapps.com.br
# Qualidade: https://qa-api-{customer_id}.systextilapps.com.br
SYSTEXTIL_API_URL=https://api-SEU_CUSTOMER_ID.systextilapps.com.br
# Autenticação: use HDR APIKey OU OAuth client credentials (token emitido na Oracle IDCS)
SYSTEXTIL_API_KEY=seu_api_key_systextil
SYSTEXTIL_CLIENT_ID=seu_client_id_systextil
SYSTEXTIL_CLIENT_SECRET=seu_client_secret_systextil
SYSTEXTIL_TOKEN_URL=https://idcs-03651be63851489595548b9127721fa1.identity.oraclecloud.com/oauth2/v1/token
SYSTEXTIL_SCOPE=C0405:PRD